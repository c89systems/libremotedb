file(READ "${BUILD}/compile_commands.json" commands)
string(JSON count LENGTH "${commands}")
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  string(JSON command GET "${commands}" ${index} command)
  foreach(flag -std=c89 -Wall -Wextra -Wpedantic -pedantic-errors -Werror)
    string(FIND "${command}" "${flag}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Missing owned C89 compile flag: ${flag}")
    endif()
  endforeach()
endforeach()
