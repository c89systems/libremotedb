# Resolve before project(), including nested try_compile calls.
get_filename_component(REMOTEDB_LIFECYCLE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(REMOTEDB_TARGET_ID "x86_64-linux-gnu" CACHE STRING "Release target")
set(CPKT_LIFECYCLE_SCRIPTS_DIR "${REMOTEDB_LIFECYCLE_DIR}/scripts" CACHE PATH "Pinned lifecycle helper collection")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES REMOTEDB_TARGET_ID REMOTEDB_BUILD_FUZZERS CPKT_LIFECYCLE_SCRIPTS_DIR)
execute_process(COMMAND "${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-toolchains.sh" discover "${REMOTEDB_TARGET_ID}"
  RESULT_VARIABLE result OUTPUT_VARIABLE description ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT description MATCHES "(^|[\r\n])status=ready([\r\n]|$)")
  message(FATAL_ERROR "Pinned collection unavailable: ${error}\nPrepare with: ${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-toolchains.sh ensure ${REMOTEDB_TARGET_ID}")
endif()
function(rdb_resolve key output)
  string(REGEX MATCH "(^|\n)${key}=([^\r\n]+)" match "${description}")
  if(NOT match)
    message(FATAL_ERROR "Resolver did not provide ${key}")
  endif()
  set(${output} "${CMAKE_MATCH_2}" CACHE STRING "Pinned collection ${key}" FORCE)
endfunction()
foreach(pair "cc;CMAKE_C_COMPILER" "cxx;CMAKE_CXX_COMPILER" "ld;CMAKE_LINKER"
    "ar;CMAKE_AR" "ranlib;CMAKE_RANLIB" "strip;CMAKE_STRIP" "nm;CMAKE_NM")
  list(GET pair 0 key)
  list(GET pair 1 variable)
  rdb_resolve("${key}" "${variable}")
endforeach()
rdb_resolve(root REMOTEDB_TOOLCHAIN_ROOT)
if(REMOTEDB_TARGET_ID STREQUAL "arm64-apple-darwin")
  set(CMAKE_SYSTEM_NAME Darwin)
  set(CMAKE_SYSTEM_PROCESSOR arm64)
  set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "" FORCE)
  set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0 CACHE STRING "" FORCE)
  rdb_resolve(prefix CPKT_OSXCROSS_HOST)
  rdb_resolve(otool CPKT_OTOOL)
  rdb_resolve(mig CPKT_MIG)
  rdb_resolve(migcom CPKT_MIGCOM)
  set(ENV{PATH} "${REMOTEDB_TOOLCHAIN_ROOT}/bin:$ENV{PATH}")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "--ld-path=${CMAKE_LINKER}")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "--ld-path=${CMAKE_LINKER}")
  set(CMAKE_MODULE_LINKER_FLAGS_INIT "--ld-path=${CMAKE_LINKER}")
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
else()
  foreach(pair "sysroot;CMAKE_SYSROOT" "readelf;CMAKE_READELF" "objcopy;CMAKE_OBJCOPY"
      "objdump;CMAKE_OBJDUMP" "addr2line;CMAKE_ADDR2LINE")
    list(GET pair 0 key)
    list(GET pair 1 variable)
    rdb_resolve("${key}" "${variable}")
  endforeach()
  execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-prog-name=ld OUTPUT_VARIABLE linker OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-file-name=libc.a OUTPUT_VARIABLE libc OUTPUT_STRIP_TRAILING_WHITESPACE)
  file(REAL_PATH "${linker}" linker)
  file(REAL_PATH "${libc}" libc)
  string(FIND "${linker}" "${REMOTEDB_TOOLCHAIN_ROOT}/" linker_index)
  string(FIND "${libc}" "${CMAKE_SYSROOT}/" libc_index)
  if(NOT linker_index EQUAL 0 OR NOT libc_index EQUAL 0)
    message(FATAL_ERROR "Compiler selected foreign linker or libc: ${linker}; ${libc}")
  endif()
  set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT};${REMOTEDB_TOOLCHAIN_ROOT}")
  list(APPEND CMAKE_FIND_ROOT_PATH ${CMAKE_PREFIX_PATH})
  set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
  set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
  set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
  set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
  if(REMOTEDB_TARGET_ID MATCHES "^aarch64")
    set(CMAKE_SYSTEM_NAME Linux)
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  elseif(REMOTEDB_TARGET_ID MATCHES "^armhf")
    set(CMAKE_SYSTEM_NAME Linux)
    set(CMAKE_SYSTEM_PROCESSOR arm)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  elseif(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    message(FATAL_ERROR "Native development currently requires x86_64 Linux")
  endif()
  if(REMOTEDB_BUILD_FUZZERS)
    execute_process(COMMAND "${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-aflpp.sh" discover OUTPUT_VARIABLE description RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT description MATCHES "(^|[\r\n])status=ready([\r\n]|$)")
      message(FATAL_ERROR "Pinned AFL++ unavailable; prepare with: ${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-aflpp.sh ensure")
    endif()
    rdb_resolve(cc CMAKE_C_COMPILER)
    rdb_resolve(cxx CMAKE_CXX_COMPILER)
    rdb_resolve(helper REMOTEDB_AFL_PATH)
    set(ENV{AFL_PATH} "${REMOTEDB_AFL_PATH}")
  endif()
endif()
