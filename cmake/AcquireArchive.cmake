# All dependency downloads pass through this verified, shared archive cache.
function(remotedb_acquire_archive component url digest out)
  string(LENGTH "${digest}" digest_length)
  if(NOT digest_length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "${component}: an exact SHA-256 pin is required")
  endif()
  if(NOT IS_ABSOLUTE "${CPKT_DEPENDENCY_CACHE}")
    message(FATAL_ERROR "CPKT_DEPENDENCY_CACHE must be an absolute path")
  endif()
  get_filename_component(name "${url}" NAME)
  set(directory "${CPKT_DEPENDENCY_CACHE}/archives/sha256/${digest}")
  file(MAKE_DIRECTORY "${directory}" "${CPKT_DEPENDENCY_CACHE}/locks")
  file(LOCK "${CPKT_DEPENDENCY_CACHE}/locks/${digest}.lock" GUARD FUNCTION TIMEOUT 120)
  set(archive "${directory}/${name}")
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" actual)
    if(actual STREQUAL digest)
      set(${out} "${archive}" PARENT_SCOPE)
      return()
    endif()
    file(REMOVE "${archive}")
  endif()
  file(GLOB candidates "${directory}/*")
  foreach(candidate IN LISTS candidates)
    if(candidate MATCHES "[.]partial$" OR IS_DIRECTORY "${candidate}")
      continue()
    endif()
    file(SHA256 "${candidate}" actual)
    if(actual STREQUAL digest)
      configure_file("${candidate}" "${archive}" COPYONLY)
      set(${out} "${archive}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(RANDOM LENGTH 16 token)
  set(temp "${archive}.${token}.partial")
  foreach(attempt RANGE 1 3)
    file(DOWNLOAD "${url}" "${temp}" TLS_VERIFY ON STATUS result TIMEOUT 120)
    list(GET result 0 code)
    if(code EQUAL 0)
      file(SHA256 "${temp}" actual)
      if(actual STREQUAL digest)
        file(RENAME "${temp}" "${archive}")
        set(${out} "${archive}" PARENT_SCOPE)
        return()
      endif()
      set(result "checksum mismatch: ${actual}")
    endif()
    file(REMOVE "${temp}")
  endforeach()
  message(FATAL_ERROR "${component}: ${url}; expected SHA256 ${digest}; cache ${archive}; ${result}")
endfunction()
