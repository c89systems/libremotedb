if(NOT KIND STREQUAL "pathname" AND NOT KIND STREQUAL "abstract")
  message(FATAL_ERROR "REMOTEDB_E2E_SOCKET_KIND must be pathname or abstract")
endif()
foreach(path "${PROJECT_ROOT}/build" "${WORK}" "${WORK}/state" "${WORK}/tmp" "${WORK}/logs" "${WORK}/credentials" "${WORK}/storage")
  if(IS_SYMLINK "${path}")
    message(FATAL_ERROR "Refusing service-state symlink: ${path}")
  endif()
endforeach()
function(quote value output)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(temporary_root "${WORK}/tmp")
file(MAKE_DIRECTORY "${WORK}/state/server" "${temporary_root}/client" "${temporary_root}/podman" "${WORK}/logs" "${WORK}/credentials")
file(CHMOD "${WORK}/credentials" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(CONTROL "${POD}-control")
set(SERVER_SOCKET_MOUNT "")
set(CLIENT_SOCKET_MOUNT "")
set(SOCKET_VOLUME "")
if(KIND STREQUAL "pathname")
  set(CONTROL "/socket/control.sock")
  set(SERVER_SOCKET_MOUNT "        - name: sockets\n          mountPath: /socket")
  set(CLIENT_SOCKET_MOUNT "${SERVER_SOCKET_MOUNT}")
  file(MAKE_DIRECTORY "${WORK}/state/sockets")
  quote("${WORK}/state/sockets" sockets)
  set(SOCKET_VOLUME "    - name: sockets\n      hostPath:\n        path: ${sockets}\n        type: Directory")
endif()
quote("${WORK}/state/server" SERVER_STATE)
quote("${temporary_root}/client" CLIENT_WORK)
quote("${KIND}" KIND)
quote("${CONTROL}" CONTROL)
file(READ "${PROJECT_ROOT}/devenv.yaml.in" manifest)
foreach(key POD SERVER_IMAGE CLIENT_IMAGE UID GID KIND CONTROL SERVER_STATE CLIENT_WORK SERVER_SOCKET_MOUNT CLIENT_SOCKET_MOUNT SOCKET_VOLUME)
  string(REPLACE "@@${key}@@" "${${key}}" manifest "${manifest}")
endforeach()
if(manifest MATCHES "@@")
  message(FATAL_ERROR "Unknown manifest placeholder")
endif()
file(WRITE "${WORK}/devenv.yaml" "${manifest}")
file(CHMOD "${WORK}/devenv.yaml" PERMISSIONS OWNER_READ OWNER_WRITE)
