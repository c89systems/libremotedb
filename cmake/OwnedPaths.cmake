# Resolve through existing ancestors before accepting disposable/generated paths.
function(remotedb_owned_path path)
  if(NOT IS_ABSOLUTE "${path}")
    message(FATAL_ERROR "Generated/cache paths must be absolute: ${path}")
  endif()
  set(existing "${path}")
  set(suffix "")
  while(NOT EXISTS "${existing}" AND NOT IS_SYMLINK "${existing}")
    get_filename_component(name "${existing}" NAME)
    get_filename_component(existing "${existing}" DIRECTORY)
    set(suffix "/${name}${suffix}")
  endwhile()
  file(REAL_PATH "${existing}" physical)
  set(physical "${physical}${suffix}")
  foreach(allowed "${CMAKE_SOURCE_DIR}/build" "${CMAKE_SOURCE_DIR}/.cache" ${ARGN})
    cmake_path(IS_PREFIX allowed "${physical}" NORMALIZE accepted)
    if(accepted)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Path must stay in this checkout's build/.cache or the global cpkt cache: ${path}")
endfunction()
foreach(directory build dist .cache)
  if(IS_SYMLINK "${CMAKE_SOURCE_DIR}/${directory}")
    message(FATAL_ERROR "Refusing redirected generated root: ${directory}")
  endif()
endforeach()
set(remotedb_global_cache "$ENV{HOME}/.cache/cpkt")
if(NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
  set(remotedb_global_cache "$ENV{XDG_CACHE_HOME}/cpkt")
endif()
if(NOT CMAKE_SCRIPT_MODE_FILE)
  remotedb_owned_path("${CMAKE_BINARY_DIR}")
endif()
remotedb_owned_path("${CPKT_DEPENDENCY_CACHE}" "${remotedb_global_cache}")
if(NOT "$ENV{CPKT_TOOLCHAIN_CACHE}" STREQUAL "")
  remotedb_owned_path("$ENV{CPKT_TOOLCHAIN_CACHE}" "${remotedb_global_cache}")
endif()
