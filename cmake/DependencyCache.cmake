if(NOT CPKT_DEPENDENCY_CACHE)
  if(NOT "$ENV{CPKT_DEPENDENCY_CACHE}" STREQUAL "")
    set(CPKT_DEPENDENCY_CACHE "$ENV{CPKT_DEPENDENCY_CACHE}")
  elseif(NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(CPKT_DEPENDENCY_CACHE "$ENV{XDG_CACHE_HOME}/cpkt/deps")
  elseif(NOT "$ENV{HOME}" STREQUAL "")
    set(CPKT_DEPENDENCY_CACHE "$ENV{HOME}/.cache/cpkt/deps")
  else()
    message(FATAL_ERROR "HOME, XDG_CACHE_HOME, or CPKT_DEPENDENCY_CACHE is required")
  endif()
endif()
set(CPKT_DEPENDENCY_CACHE "${CPKT_DEPENDENCY_CACHE}" CACHE PATH "Shared verified dependency archives")
