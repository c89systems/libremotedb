file(READ "${TREE}/share/remotedb/dependencies.json" document)
string(JSON backend GET "${document}" backend)
string(JSON count LENGTH "${document}" dependencies)
if(NOT backend STREQUAL "mock" OR NOT count EQUAL 1)
  message(FATAL_ERROR "Invalid dependency provenance")
endif()
file(READ "${RECIPE}" recipe)
include("${CMAKE_CURRENT_LIST_DIR}/LonejsonPins.cmake")
if(TARGET_ID MATCHES "darwin$")
  string(REGEX MATCH "set\\(digest ([0-9a-f]+)\\)" match "${recipe}")
  set(archive "lonejson-0.44.0.tar.gz")
else()
  set(CMAKE_MATCH_1 "${lonejson_${TARGET_ID}}")
  set(archive "liblonejson-0.44.0-${TARGET_ID}.tar.gz")
endif()
set(digest "${CMAKE_MATCH_1}")
set(expected_name lonejson)
set(expected_version 0.44.0)
set(expected_target "${TARGET_ID}")
set(expected_sha256 "${digest}")
set(expected_archive "${archive}")
set(expected_license MIT)
set(expected_bundled ON)
set(expected_url "https://github.com/sa6mwa/lonejson/releases/download/v0.44.0/${archive}")
foreach(key name version target sha256 archive license bundled url)
  string(JSON actual GET "${document}" dependencies 0 "${key}")
  if(NOT actual STREQUAL expected_${key})
    message(FATAL_ERROR "Dependency ${key} mismatch: ${actual}")
  endif()
endforeach()
file(READ "${TREE}/include/remotedb/version.h" header)
string(FIND "${header}" "\"${EXPECTED_VERSION}\"" found)
if(found EQUAL -1)
  message(FATAL_ERROR "SDK header version mismatch")
endif()
foreach(component remotedb remotedbsrv)
  file(READ "${TREE}/lib/pkgconfig/${component}.pc" pc)
  string(FIND "${pc}" "Requires.private: lonejson = 0.44.0" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing private static closure")
  endif()
endforeach()
