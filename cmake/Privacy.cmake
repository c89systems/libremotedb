# Inspect final bytes, including bounded declared release-archive nesting.
function(remotedb_privacy tree)
  string(CONCAT temporary "/" "tmp/")
  string(CONCAT private_temporary "/private/" "tmp/")
  string(CONCAT unix_home "/" "home/")
  string(CONCAT darwin_home "/" "Users/")
  string(CONCAT builds "/" "builds/")
  string(CONCAT toolchains "cpkt/" "toolchains/roots/")
  string(CONCAT dependencies "cpkt/" "deps/archives/")
  string(CONCAT afl "__" "afl_")
  string(CONCAT asan "__" "asan_")
  string(CONCAT ubsan "__" "ubsan_")
  set(forbidden "${REMOTEDB_SOURCE_ROOT}" "$ENV{HOME}" "${temporary}" "${private_temporary}"
    "${unix_home}" "${darwin_home}" "${builds}" "${toolchains}" "${dependencies}" "${afl}" "${asan}" "${ubsan}")
  file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${tree}" "${tree}/*" "${tree}/.*")
  foreach(entry IN LISTS entries)
    if(entry MATCHES "(^|/)([.]git|[.]cache|build|[.]env)(/|$)")
      message(FATAL_ERROR "Generated/private artifact: ${entry}")
    endif()
    if(IS_DIRECTORY "${tree}/${entry}" OR IS_SYMLINK "${tree}/${entry}")
      continue()
    endif()
    file(READ "${tree}/${entry}" data HEX)
    if(data MATCHES "^7f454c46")
      string(CONCAT runtime_template "/" "tmp/tmpfile_XXXXXX")
      string(HEX "${runtime_template}" runtime_hex)
      string(REPLACE "${runtime_hex}00" "" data "${data}")
      string(CONCAT runtime_prefix "/" "tmp/tmpfile_XXX")
      string(HEX "${runtime_prefix}" runtime_hex)
      string(REPLACE "${runtime_hex}" "" data "${data}")
    endif()
    foreach(marker IN LISTS forbidden)
      if(marker STREQUAL "")
        continue()
      endif()
      string(HEX "${marker}" marker_hex)
      string(FIND "${data}" "${marker_hex}" found)
      if(NOT found EQUAL -1)
        message(FATAL_ERROR "Local path/instrumentation leak: ${entry}")
      endif()
    endforeach()
    if(entry MATCHES "[.](tar[.]gz|tgz|tar[.]xz)$")
      message(FATAL_ERROR "Unexpected nested release archive: ${entry}")
    endif()
  endforeach()
endfunction()
if(DEFINED TREE)
  remotedb_privacy("${TREE}")
endif()
